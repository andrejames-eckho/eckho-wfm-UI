# Database Configuration
POSTGRES_USER=eckho_user
POSTGRES_PASSWORD=eckho_password
POSTGRES_DB=eckho_wfm
DB_HOST=localhost  # Use 'db' when running in Docker, 'localhost' when running locally
DB_PORT=5432

# pgAdmin Configuration
PGADMIN_EMAIL=admin@eckho.com
PGADMIN_PASSWORD=admin123

# Security Settings
# Generate a new secret key with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30